#!/usr/bin/env bash
#
# pre-commit: enforce plugin manifest version consistency.
#
# The check itself lives in .githooks/version_drift.py so it can be run by
# hand (python3 .githooks/version_drift.py) and its fetch seams can be
# exercised without a commit. This wrapper only decides WHETHER to run it.
#
# The check runs only when the commit touches plugin files or the marketplace
# manifest — unrelated commits (tooling, docs-only on CLAUDE.md, etc.) pass
# through untouched.
#
# Setup: run once after cloning
#   git config core.hooksPath .githooks

set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
MARKETPLACE="$REPO_ROOT/.claude-plugin/marketplace.json"

if [ ! -f "$MARKETPLACE" ]; then
  exit 0
fi

staged=$(git diff --cached --name-only)
if ! printf '%s\n' "$staged" | grep -qE '^(plugins/|\.claude-plugin/marketplace\.json)'; then
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found — skipping version drift check." >&2
  echo "pre-commit: install python3 or disable this hook if you know what you're doing." >&2
  exit 1
fi

exec python3 "$REPO_ROOT/.githooks/version_drift.py" "$REPO_ROOT"
